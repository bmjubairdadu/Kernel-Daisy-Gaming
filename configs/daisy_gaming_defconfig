# Kernel Daisy for Gaming - Defconfig Fragment - FIXED (Deep Audit 2026-09-01)
# Merge: merge_config.sh -m -O out arch/arm64/configs/daisy_defconfig configs/daisy_gaming_defconfig
# Snapdragon 625 (MSM8953) - Linux 4.9.337 (Latest Final LTS - EOL 2023-01-05)
# Validated against CAF LA.UM.8.6.r1 msm8953 4.9 - no invalid governors/schedulers
CONFIG_LOCALVERSION="-Daisy-Gaming-4.9.337-JUBAIR"
# CONFIG_LOCALVERSION_AUTO is not set

# === CPU Governors & Scheduler (verified in msm8953 4.9) ===
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_INTERACTIVE=y
# CONFIG_CPU_FREQ_GOV_CONSERVATIVE is not set
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
# CONFIG_CPU_FREQ_GOV_POWERSAVE is not set
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_BOOST=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_SCHED_TUNE=y
CONFIG_SCHEDTUNE_BOOST=y
CONFIG_ENERGY_AWARE=y
CONFIG_MSM_PERFORMANCE=y

# === GPU - Adreno 506 - governor validated ===
CONFIG_MSM_KGSL=y
CONFIG_KGSL_PER_PROCESS_PAGE_TABLE=y
CONFIG_MSM_ADRENO_DEFAULT_GOVERNOR="msm-adreno-tz"
CONFIG_QCOM_KGSL=y

# === Thermal ===
CONFIG_THERMAL=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_THERMAL_GOV_USER_SPACE=y
CONFIG_QCOM_THERMAL=y
CONFIG_THERMAL_WRITABLE_TRIPS=y
CONFIG_QCOM_TSENS=y

# === I/O Schedulers - validated for 4.9 msm8953 (cfq/deadline/bfq exist, maple/anxiety do not) ===
CONFIG_IOSCHED_CFQ=y
CONFIG_IOSCHED_DEADLINE=y
CONFIG_IOSCHED_BFQ=y
CONFIG_DEFAULT_IOSCHED="cfq"
# BFQ is performance on flash; deadline also good for gaming. User can switch via kernel manager.

# === Memory & ZRAM ===
CONFIG_ZRAM=y
CONFIG_ZRAM_LZ4_COMPRESS=y
CONFIG_ZSMALLOC=y
CONFIG_LZ4_COMPRESS=y
CONFIG_LZ4_DECOMPRESS=y
# CONFIG_ZSWAP is not set
CONFIG_SWAP=y

# === Network - Low Latency Gaming ===
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_DEFAULT_TCP_CONG="westwood"
CONFIG_NET_SCH_FQ_CODEL=y

# === Display - KCAL (daisy uses MDSS, not DRM) ===
CONFIG_FB_MSM_MDSS_KCAL_CTRL=y
# CONFIG_DRM_MSM_KCAL is not set

# === Sound & Vibration ===
CONFIG_SND_SOC_WCD9335=y
CONFIG_QCOM_HAPTICS=y

# === WireGuard - built-in so no modules/ko needed ===
CONFIG_WIREGUARD=y

# === Performance ===
CONFIG_HZ_300=y
CONFIG_HZ=300
# CONFIG_NO_HZ_FULL is not set
CONFIG_HIGH_RES_TIMERS=y

# Disable debug for performance (correct # is not set syntax)
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_DETECT_HUNG_TASK is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_DEBUG_INFO is not set
CONFIG_DEBUG_FS=y
CONFIG_MAGIC_SYSRQ=y
# CONFIG_SLUB_DEBUG is not set

# === Charger - SD625 uses qpnp-smbcharger (SMBLIB is SDM630) ===
CONFIG_QPNP_SMBCHARGER=y
# CONFIG_QCOM_SMBLIB is not set
# CONFIG_USB_FAST_CHARGE is not set

# === FS ===
CONFIG_F2FS_FS=y
CONFIG_F2FS_STAT_FS=y
CONFIG_F2FS_FS_XATTR=y
# Do NOT disable MMC CRC - data corruption on eMMC aging (leave default y)
# CONFIG_MMC_CRC is not set  <-- REMOVED (keeps CRC enabled)

# Power efficient workqueue
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y

# === Wakelock blocker - boeffla implies blocker ===
CONFIG_BOEFFLA_WL_BLOCKER=y
# CONFIG_WAKELOCK_BLOCKER is not set

# === Misc Gaming ===
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
# CONFIG_RT_GROUP_SCHED is not set
CONFIG_SCHED_AUTOGROUP=y
# CONFIG_VT is not set
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
# CONFIG_CC_OPTIMIZE_FOR_SIZE is not set

# === Hardening for 4.9.337 CVE coverage ===
CONFIG_HARDENED_USERCOPY=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_REFCOUNT_FULL=y
CONFIG_BUG=y
