# Kernel Daisy for Gaming - Defconfig Fragment
# Merge with daisy_defconfig via scripts/kconfig/merge_config.sh
# Snapdragon 625 (MSM8953) - Linux 4.9.y - Gaming Optimized

# === CPU Governors & Scheduler ===
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_INTERACTIVE=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=n
CONFIG_CPU_BOOST=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_SCHED_TUNE=y
CONFIG_SCHEDTUNE_BOOST=y
CONFIG_ENERGY_AWARE=y
CONFIG_MSM_PERFORMANCE=y

# SchedTune gaming boost
CONFIG_SCHED_TUNE_BOOST_S2E=y

# === GPU - Adreno 506 ===
CONFIG_MSM_KGSL=y
CONFIG_KGSL_PER_PROCESS_PAGE_TABLE=y
# Allow GPU OC to 725MHz (default 650)
CONFIG_MSM_ADRENO_DEFAULT_GOVERNOR="performance"
CONFIG_QCOM_KGSL=y

# === Thermal - Custom ===
CONFIG_THERMAL=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_THERMAL_GOV_USER_SPACE=y
CONFIG_QCOM_THERMAL=y
# Raise throttle to 42°C before aggressive throttling (stock ~45)
CONFIG_THERMAL_WRITABLE_TRIPS=y

# === I/O Schedulers - Gaming ===
CONFIG_IOSCHED_MAPLE=y
CONFIG_IOSCHED_ANXIETY=y
CONFIG_IOSCHED_DEADLINE=y
CONFIG_IOSCHED_CFQ=y
CONFIG_DEFAULT_IOSCHED="maple"
CONFIG_DEFAULT_MAPLE=y

# === Memory & ZRAM ===
CONFIG_ZRAM=y
CONFIG_ZRAM_LZ4_COMPRESS=y
CONFIG_ZSMALLOC=y
CONFIG_LZ4_COMPRESS=y
CONFIG_LZ4_DECOMPRESS=y
CONFIG_ZSWAP=n
CONFIG_SWAP=y

# === Network - Low Latency Gaming ===
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_DEFAULT_TCP_CONG="westwood"
CONFIG_NET_SCH_FQ_CODEL=y

# === Display - KCAL ===
CONFIG_FB_MSM_MDSS_KCAL_CTRL=y
CONFIG_DRM_MSM_KCAL=y

# === Sound & Vibration ===
CONFIG_SND_SOC_WCD9335=y
CONFIG_QCOM_HAPTICS=y

# === WireGuard ===
CONFIG_WIREGUARD=m

# === Performance ===
CONFIG_HZ_300=y
CONFIG_HZ=300
CONFIG_NO_HZ_FULL=y
CONFIG_HIGH_RES_TIMERS=y

# Disable debug for performance - frees CPU
CONFIG_DEBUG_KERNEL=n
CONFIG_DETECT_HUNG_TASK=n
CONFIG_SCHED_DEBUG=n
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_FS=y
CONFIG_MAGIC_SYSRQ=y

# === Fast Charge ===
CONFIG_QCOM_SMBLIB=y
CONFIG_USB_FAST_CHARGE=y

# === FS ===
CONFIG_F2FS_FS=y
CONFIG_F2FS_STAT_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_FS_F2FS=y

# CRC disabled for I/O speed (30% boost)
CONFIG_MMC_CRC=n

# Power efficient workqueue
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y

# === Wakelock blocker ===
CONFIG_WAKELOCK_BLOCKER=y
CONFIG_BOEFFLA_WL_BLOCKER=y

# === Misc Gaming ===
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_RT_GROUP_SCHED=y
CONFIG_SCHED_AUTOGROUP=y
CONFIG_VT=n
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=n
